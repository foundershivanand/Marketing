# Application
APP_NAME=LaunchPilot
APP_BASE_URL=http://localhost:5173

# AI (gemini | openai | mock)
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-pro
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cloudflare
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Database
DB_NAME=launchpilot-db

# Security (32-character hex or string for AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ALLOWED_ADMIN_EMAIL=admin@example.com

# Optional email provider
RESEND_API_KEY=
SENDER_EMAIL=launch@example.com
